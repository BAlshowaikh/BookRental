@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <h2 class="text-dark">@ViewData["Title"]</h2>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h4 class="text-dark">Create a new account.</h4>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating">
                <p class="mb-1" style="font-size: 1.1rem">First Name</p>
                <input asp-for="Input.FirstName" class="form-control mb-3" aria-required="true" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <p class="mb-1" style="font-size: 1.1rem">Last Name</p>
                <input asp-for="Input.LastName" class="form-control mb-3" aria-required="true" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <p class="mb-1" style="font-size: 1.1rem">Contact Number</p>
                <input asp-for="Input.ContactNo" class="form-control mb-3" />
                <span asp-validation-for="Input.ContactNo" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <p class="mb-1" style="font-size: 1.1rem">Email</p>
                <input asp-for="Input.Email" class="form-control mb-3" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <p class="mb-1" style="font-size: 1.1rem">Password</p>
                <input asp-for="Input.Password" class="form-control mb-3" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <p class="mb-1" style="font-size: 1.1rem">Confirm Password</p>
                <input asp-for="Input.ConfirmPassword" class="form-control mb-3" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </div>
    <div class="col-md-2"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

