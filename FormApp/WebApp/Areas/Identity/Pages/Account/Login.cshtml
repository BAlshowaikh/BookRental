@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}


<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <section>
            <h2 class="text-dark">@ViewData["Title"]</h2>
            <form id="account" method="post">
                <h4 class="text-dark">Use a local account to log in.</h4>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-floating">
                    <p class="mb-1" style="font-size: 1.1rem">Email</p>
                    <input asp-for="Input.Email" class="form-control mb-3" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating">
                    <p class="mb-1" style="font-size: 1.1rem">Password</p>
                    <input asp-for="Input.Password" class="form-control mb-3" autocomplete="current-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div>
                    <div class="checkbox">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary mb-2">Log in</button>
                </div>
                <div class="d-flex justify-content-center">
                    <p class="text-center">
                        <a id="forgot-password" asp-page="./ForgotPassword" class="me-5 ms-5">Forgot your password?</a>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="me-5 ms-5">Register as a new user</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-2"></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
