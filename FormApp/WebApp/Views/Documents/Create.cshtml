@model BookRentalObject.Document

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Document</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UploadDate" class="control-label"></label>
                <input asp-for="UploadDate" class="form-control" />
                <span asp-validation-for="UploadDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Blob" class="control-label"></label>
                <input asp-for="Blob" class="form-control" />
                <span asp-validation-for="Blob" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RentalRequestId" class="control-label"></label>
                <select asp-for="RentalRequestId" class ="form-control" asp-items="ViewBag.RentalRequestId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

