 @model IEnumerable<BookRentalObject.RentalTransaction>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-dark text-center">Rental Transactions</h1>

<!--Search and filter-->
<div class="row py-3">
    <div class="col-12">
        <form asp-controller="RentalTransactions" asp-action="Index" method="get" class="row gx-2 align-items-center" autocomplete="off">
            <label class="form-label px-2 ms-2" style="width: 9.5%">Transaction ID:</label>
            <div class="col-auto position-relative">
                <input type="text" name="SearchString" value="@Context.Request.Query["SearchString"].ToString()" class="form-control" placeholder="Transaction ID" />
            </div>

            <div class="col-auto">
                <label class="form-label ms-3" style="width: 9.5%">Customer:</label>
            </div>
            <div class="col-auto">
                <select asp-items="ViewBag.CustList" name="SearchCustomer" class="form-select" >
                    <option disabled selected value="0">Select Customer</option>
                </select>
            </div>

            <div class="col"></div>

            <!-- Buttons - now aligned to far right -->
            <div class="col-auto">
                <input type="submit" value="Search" class="btn btn-primary mx-3" />
            </div>
            <div class="col-auto">
                <a asp-controller="RentalTransactions" asp-action="Index" class="btn btn-outline-danger">Clear</a>
            </div>
        </form>
    </div>
</div>


<div class="container my-4">
	<div class="row">
		@foreach (var transaction in Model)
		{
			var borderClass = transaction.TransactionId switch
			{
				_ => "border border-2 border-dark border-opacity-100"      
			};

			<div class="col-md-4">
				<div class="third-card mb-4 card-clickable @borderClass"
					 data-modal-id="detailsModal-@transaction.TransactionId"
					 style="cursor: pointer;">


					<div class="card-info">
						<h3 class="text-dark">Transaction ID: @transaction.TransactionId</h3>
						<h5>Book Name: @transaction.Book.Name</h5>
						<h5>Customer Name: @transaction.User.FullName</h5>
						<h5>Rental Start Date: @transaction.RentalStartDate</h5>
						<h5>Return Date: @transaction.ReturnDate</h5>
						<h5>Rental Fee: @transaction.RentalFee</h5>
						<h5>Payment Method: @transaction.PaymentMethod.PaymentMethod1</h5>
						<h5>Payment Status: @transaction.PaymentStatus.PaymentStatus1</h5>

						<div class="mt-3 d-flex flex-wrap gap-2">
							<a asp-action="Edit"
							   asp-route-id="@transaction.TransactionId"
							   class="btn btn-sm btn-light">
								Edit
							</a>
						</div>
					</div>
				</div>

				<!-- Modal for each rental transaction details -->
				<div class="modal fade fade-scale" id="detailsModal-@transaction.TransactionId" tabindex="-1" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content shadow-lg rounded-3">
							<div class="modal-header bg-secondary text-white border-0">
								<h5 class="modal-title w-100 text-center">
									<i class="bi bi-info-circle me-2"></i>
									Rental Transaction Details
								</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								<div class="info-group mb-3">
									<p><strong>Transaction ID:</strong> @transaction.TransactionId</p>
									<p><strong>Customer Name:</strong> @transaction.User.FullName</p>
									<p><strong>Book Name:</strong> @transaction.Book.Name</p>
									<p><strong>Rental Start Date:</strong> @transaction.RentalStartDate</p>
									<p><strong>Return Date:</strong> @transaction.ReturnDate</p>
									<p><strong>Rental Fee:</strong> @transaction.RentalFee</p>
									<p><strong>Payment Method:</strong> @transaction.PaymentMethod.PaymentMethod1</p>
									<p><strong>Payment Status:</strong> @transaction.PaymentStatus.PaymentStatus1</p>
								</div>
								<div class="text-center">
									<button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>

