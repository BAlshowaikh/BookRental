@using WebApp.ViewModel;
 @model IEnumerable<RentalTransactionViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-dark text-center">Rental Transactions</h1>

<!--Search and filter-->
<div class="row py-3">
    <div class="col-12">
        <form asp-controller="RentalTransactions" asp-action="Index" method="get" class="row gx-2 align-items-center" autocomplete="off">
            <label class="form-label px-2 ms-2" style="width: 9.5%">Transaction ID:</label>
            <div class="col-auto position-relative">
                <input type="text" name="SearchString" value="@Context.Request.Query["SearchString"].ToString()" class="form-control" placeholder="Transaction ID" />
            </div>

            <div class="col-auto">
                <label class="form-label ms-3" style="width: 9.5%">Customer:</label>
            </div>
            <div class="col-auto">
                <select asp-items="ViewBag.CustList" name="SearchCustomer" class="form-select" >
                    <option disabled selected value="0">Select Customer</option>
                </select>
            </div>

            <div class="col"></div>

            <!-- Buttons - now aligned to far right -->
            <div class="col-auto">
                <input type="submit" value="Search" class="btn btn-primary mx-3" />
            </div>
            <div class="col-auto">
                <a asp-controller="RentalTransactions" asp-action="Index" class="btn btn-outline-danger">Clear</a>
            </div>
        </form>
    </div>
</div>


<div class="container my-4">
	<div class="row">
		@foreach (var card in Model)
		{
			<div class="col-md-4">
				<div class="second-card mb-4 card-clickable"
					 data-modal-id="detailsModal-@card.RentalTransaction.TransactionId"
					 style="cursor: pointer;">


					<div class="card-info">
						<h3>Transaction ID: @card.RentalTransaction.TransactionId</h3>
						<p>Book Name: @card.RentalTransaction.Book.Name</p>
						<p>Customer Name: @card.RentalTransaction.User.FullName</p>
						<p>Rental Start Date: @card.RentalTransaction.RentalStartDate</p>
					
						<div class="mt-3 d-flex flex-wrap gap-2">
							@if (card.RentalTransaction.ReturnRecords != null && card.RentalTransaction.ReturnRecords.Any()) 
							{
								<button class="btn btn-sm btn-light" disabled>Edit</button>
							}
							else
							{
								<a asp-action="Edit"
								asp-route-id="@card.RentalTransaction.TransactionId"
								class="btn btn-sm btn-light">
									Edit
								</a>
							}

							<a asp-controller="ReturnRecords" asp-action="Create"
							   asp-route-id="@card.RentalTransaction.TransactionId"
							   class="btn btn-sm btn-light">
								Generate Return Record
							</a>
						</div>
					</div>
				</div>

				<!-- Modal for each rental transaction details -->
				<div class="modal fade fade-scale" id="detailsModal-@card.RentalTransaction.TransactionId" tabindex="-1" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content shadow-lg rounded-3">
							<div class="modal-header bg-secondary text-white border-0">
								<h5 class="modal-title w-100 text-center">
									<i class="bi bi-info-circle me-2"></i>
									Rental Transaction Details
								</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								<div class="info-group mb-3">
									<p class="mb-1"><strong>Transaction ID:</strong> @card.RentalTransaction.TransactionId</p>
									<p class="mb-1"><strong>Customer Name:</strong> @card.RentalTransaction.User.FullName</p>
									<p class="mb-1"><strong>Book Name:</strong> @card.RentalTransaction.Book.Name</p>
									<p class="mb-1"><strong>Rental Start Date:</strong> @card.RentalTransaction.RentalStartDate</p>
									<p class="mb-1"><strong>Return Date:</strong> @card.RentalTransaction.ReturnDate</p>
									<p class="mb-1"><strong>Rental Fee:</strong>  @card.RentalTransaction.RentalFee</p>
									<p class="mb-1"><strong>Payment Method:</strong> @card.RentalTransaction.PaymentMethod.PaymentMethod1</p>
									<p class="mb-1"><strong>Payment Status:</strong> @card.RentalTransaction.PaymentStatus.PaymentStatus1</p>
								</div>
								<div class="text-center">
									<button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- Pagination -->
		<div class="row mt-4">
			<div class="col text-center">
				@if (ViewBag.TotalPages > 1)
				{
					<nav aria-label="Page navigation">
						<ul class="pagination justify-content-center">
							@for (int i = 1; i <= ViewBag.TotalPages; i++)
							{
								<li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
									<a class="page-link"
									   href="@Url.Action("Index", new {
									   page = i,
									   SearchString = Context.Request.Query["SearchString"],
									   SearchCustomer = Context.Request.Query["SearchCustomer"]
								   })">@i</a>
								</li>
							}

						</ul>
					</nav>
				}
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			preventStretchedLinkClick();

			$('.card-clickable').on('click', function () {
				const modalId = $(this).data('modal-id');
				const modal = document.getElementById(modalId);

				if (modal) {
					const bsModal = new bootstrap.Modal(modal);
					bsModal.show();
				}
			});
		});
	</script>
}
