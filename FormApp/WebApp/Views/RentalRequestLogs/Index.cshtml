@model IEnumerable<WebApp.Controllers.RentalRequestLogsController.RentalRequestLogViewModel>

@{
    ViewBag.Title = "Rental Request Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Rental Request Logs</h2>

<div class="p-3 mb-4 border rounded" style="background-color: transparent;">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="source" class="form-label fw-bold">Filter by Source</label>
                <input type="text" name="source" id="source" class="form-control" />
            </div>
            <div class="col-md-4">
                <label for="user" class="form-label fw-bold">Filter by User</label>
                <select name="user" id="user" class="form-select">
                    <option>Select User</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </div>
        </div>
    </form>
</div>


<div class="table-responsive">
    <table class="table table-striped table-bordered table-sm">
        <thead class="table-light">
            <tr>
                <th>Log ID</th>
                <th>Timestamp</th>
                <th>Affected Data</th>
                <th>Source</th>
                <th>Exception</th>
                <th>User</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No records found.</td>
                </tr>
            }
            else
            {
                foreach (var log in Model)
                {
                    <tr>
                        <td>@log.LogId</td>
                        <td>@log.Timestamp.ToString("g")</td>
                        <td>@log.AffectedData</td>
                        <td>@log.Source</td>
                        <td class="text-danger">@log.Exception</td>
                        <td>@log.UserName</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="text-end mt-3">
    <form method="get" asp-action="Index">
        <button class="btn btn-primary">Refresh</button>
    </form>
</div>
