@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Statistics Overview</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Active Rentals</h5>
            <p>@ViewBag.ActiveRentals</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>On-Time Returns</h5>
            <p>@ViewBag.OnTimeReturns.ToString("F1")% </p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Late Returns</h5>
            <p>@ViewBag.LateReturns.ToString("F1")%</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <h5>Total Revenue</h5>
            <p>$@ViewBag.TotalRevenue.ToString("F2")</p>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="row mb-4">
        <!-- Chart 1 -->
        <div class="col-md-6 mb-4">
            <div class="card chart-card shadow">
                <div class="card-header bg-dark text-white text-center">
                    Most Rented Categories
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="categoryChart" height="220"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2 -->
        <div class="col-md-6 mb-4">
            <div class="card chart-card shadow">
                <div class="card-header bg-dark text-white text-center">
                    Return Statistics
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <div style="width: 300px; height: 300px; margin: auto;">
                        <canvas id="returnStatsChart" height="20"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Chart 3 -->
        <div class="col-md-6 mb-4">
            <div class="card chart-card shadow">
                <div class="card-header bg-dark text-white text-center">
                    Revenue Breakdown
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="revenueChart" height="220"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 4 -->
        <div class="col-md-6 mb-4">
            <div class="card chart-card shadow">
                <div class="card-header bg-dark text-white text-center">
                    Book Conditions
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="conditionChart" height="220"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Category Chart
        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CategoryLabels)),
                datasets: [{
                    label: 'Number of Rentals',
                    data: @Html.Raw(Json.Serialize(ViewBag.CategoryData)),
                    backgroundColor: 'rgba(109, 167, 168, 0.6)',
                    borderColor: 'rgba(109, 167, 168, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });

        // Return Stats Pie Chart
        new Chart(document.getElementById('returnStatsChart'), {
            type: 'doughnut',
            data: {
                labels: ['On-Time Returns', 'Late Returns'],
                datasets: [{
                    label: 'Return Statistics',
                    data: @Html.Raw(Json.Serialize(ViewBag.ReturnStatsData)),
                    backgroundColor: ['rgba(90, 140, 94, 0.6)', 'rgba(188, 83, 80, 0.6)'],
                    borderColor: ['rgba(90, 140, 94, 0.8)', 'rgba(188, 83, 80, 0.8)']
                }]
            }
        });

        // Revenue Breakdown Chart: Rental Fees vs Late Fees
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: ['Rental Fees', 'Late Fees'],
                datasets: [{
                    label: 'Revenue Amount',
                    data: @Html.Raw(Json.Serialize(ViewBag.RevenueData)),
                    backgroundColor: 'rgba(216, 157, 90, 0.6)',
                    borderColor: 'rgba(216, 157, 90, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            }
        });

        // Condition Chart: Number of Books by Condition
        new Chart(document.getElementById('conditionChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ConditionLabels)),
                datasets: [{
                    label: 'Number of Books',
                    data: @Html.Raw(Json.Serialize(ViewBag.ConditionData)),
                    backgroundColor: 'rgba(113, 147, 191, 0.6)',
                    borderColor: 'rgba(113, 147, 191, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });
    </script>
}
