@model IEnumerable<BookRentalObject.Book>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-dark text-center">Explore the books</h1>

<!-- Search and filter div-->
<div class="row py-3">
    <div class="col-12">
        <form asp-controller="Books" asp-action="Index" method="get" class="row gx-2 align-items-center" autocomplete="off">
            <!-- Book Name -->
            <label class="form-label px-2 ms-3" style="width: 9.5%">Book Name:</label>
            <div class="col-auto">
                <input type="text" name="SearchString" id="SearchString" data-url="@Url.Action("SearchBooks", "Books")" value="@Context.Request.Query["SearchString"].ToString()" class="form-control" placeholder="Type book's name" />
                <ul id="bookSuggestions"
                    class="list-group position-absolute">
            </div>

            <!-- Category -->
            <div class="col-auto">
                <label class="form-label ms-3">Category:</label>
            </div>
            <div class="col-auto">
                <select name="SearchCategory" asp-items="ViewBag.catlist" class="form-select">
                    <option value="">All</option>
                </select>
            </div>

            <!-- Space to push buttons right -->
            <div class="col"></div>

            <!-- Buttons - now aligned to far right -->
            <div class="col-auto">
                <input type="submit" value="Search" class="btn btn-primary mx-3" />
            </div>
            <div class="col-auto">
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-danger">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Books cards -->
<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var book in Model)
        {
            <div class="col-md-4">
                <div class="second-card" style="font-weight:bold">
                    
                    <div class="col-5 d-flex align-items-center">
                    </div>
                    <div class="card-info">
                        <h5 class="text-dark">@book.Name</h5>
                        <p>ID: @book.BookId</p>
                        <p >Category: @book.Category.CategoryName</p>
                        <p>Author: @book.Author.FullName</p>
                        <p>Availability: @book.AvailabilityStatus.AvailabilityStatus1</p>
                        <div class="mt-auto d-flex justify-content-center gap-2 pt-2">
                            <a asp-controller="RentalRequest" asp-action="Rent" asp-route-id="@book.BookId" class="btn btn-sm btn-light  prevent-stretch">Rent</a>
                            <a asp-controller="Books" asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-light  prevent-stretch">Edit</a>
                        </div>
					</div>
                    <a asp-action="Details" asp-route-id="@book.BookId" class="stretched-link" title="Click to view book details"></a>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-center">No books available.</p>
    }
</div>


<!-- JavaScript to handle the autocompletion for the book name field-->
@section Scripts{
<script>
    $(document).ready(function () {
        // Initialize the autocomplete
            setupAutocomplete("#SearchString", "#bookSuggestions", "@Url.Action("SearchBooks", "Books")");

        // Initialize the prevent stretched link click functionality
        preventStretchedLinkClick();
    });
</script>
}








