@model IEnumerable<BookRentalObject.Book>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-dark text-center">Explore the books</h1>

<!-- Search and filter div-->
<div class="row py-3">
    <div class="col-12">
        <form asp-controller="Books" asp-action="Index" method="get" class="row gx-2 align-items-center" autocomplete="off">
            <!-- Book Name -->
            <label class="form-label px-2 ms-3" style="width: 9.5%">Book Name:</label>
            <div class="col-auto position-relative">
                <input type="text" name="SearchString" id="SearchString" data-url="@Url.Action("SearchBooks", "Books")" value="@Context.Request.Query["SearchString"].ToString()" class="form-control" placeholder="Type book's name" />
                <ul id="bookSuggestions" class="list-group position-absolute w-100">
            </div>

            <!-- Category -->
            <div class="col-auto">
                <label class="form-label ms-3">Category:</label>
            </div>
            <div class="col-auto">
                <select name="SearchCategory" asp-items="ViewBag.catlist" class="form-select">
                    <option value="">All</option>
                </select>
            </div>

            <!-- Space to push buttons right -->
            <div class="col"></div>

            <!-- Buttons - now aligned to far right -->
            <div class="col-auto">
                <input type="submit" value="Search" class="btn btn-primary mx-3" />
            </div>
            <div class="col-auto">
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-danger">Clear</a>
            </div>
        </form>
    </div>

    <!-- Only Admin and manager can see the add book button-->
    @if (User.IsInRole("Admin") || User.IsInRole("Maanger"))
    {
        <a href="/Books/Create"
        class="rounded-circle shadow-lg position-fixed d-flex align-items-center justify-content-center add-book-btn"
        style="width: 50px; height: 50px; bottom: 40px; right: 20px; z-index: 1030; background-color:#79A87C; color:white; position:fixed;"
        data-bs-toggle="tooltip"
        data-bs-placement="left"
        title="Add new book">
            <i class="bi bi-plus-lg fs-4"></i>
        </a>
    }
</div>

<!-- Books cards -->
<div class="row">
    @if (Model != null && Model.Any())
    {
        var showAll = User.IsInRole("Admin") || User.IsInRole("Manager");

        foreach (var book in Model)
        {
            if (showAll || book.IsActive) // Show all books to Admin/Manager, only active to User
            {
                <div class="col-md-4">
                    <div class="second-card" style="font-weight:bold">

                        <div class="col-5 d-flex justify-content-center align-items-center" style="height: 100%; min-height: 200px;">
                            @if (book.ImageId != null)
                            {
                                <img src="@Url.Action("GetImage", "Images", new { id = book.ImageId })"
                                alt="@book.Name"
                                class="img-fluid rounded shadow-sm"
                                style="height: 180px; width: auto; object-fit: contain;" />
                            }
                        </div>

                        <div class="card-info">
                            <h5>@book.Name</h5>
                            <p>ID: @book.BookId</p>
                            <p>Category: @book.Category.CategoryName</p>
                            <p>Author: @book.Author.FullName</p>
                            <p>Availability: @book.AvailabilityStatus.AvailabilityStatus1</p>
                            <div class="mt-auto d-flex justify-content-center gap-2 pt-2">

                                <!-- Only Guest and User 'Customer' can see the rent button-->
                                @if ((User.Identity.IsAuthenticated || User.IsInRole("User")) && !showAll)
                                {
                                    <a asp-controller="RentalRequests" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-sm btn-light prevent-stretch">Rent</a>
                                }
                                <!-- Only Admin and manager can see the add book button-->
                                @if (showAll)
                                {
                                    <a asp-controller="Books" asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-light prevent-stretch">Edit</a>

                                    <button type="button"
                                    id="toggle-btn-@book.BookId"
                                    class="btn btn-sm btn-light prevent-stretch toggle-visibility"
                                    title="Show/hide Book"
                                    onclick="toggleBookVisibility(@book.BookId, @(book.IsActive ? "true" : "false"))">
                                        <i class="bi @(book.IsActive ? "bi-eye text-success" : "bi-eye-slash text-danger")" id="toggle-icon-@book.BookId"></i>
                                    </button>
                                }
                            </div>
                        </div>
                        <a asp-action="Details" asp-route-id="@book.BookId" class="stretched-link" title="Click to view book details"></a>
                    </div>
                </div>
            }
        }

        // Optional: if user is not Admin/Manager and sees no active books
        if (!showAll && !Model.Any(book => book.IsActive))
        {
            <p class="text-center">No books available.</p>
        }
    }
    else
    {
        <p class="text-center">No books available.</p>
    }
</div>


<!-- Pagination -->
<div class="row mt-4">
    <div class="col text-center">
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, SearchString = Context.Request.Query["SearchString"], SearchCategory = Context.Request.Query["SearchCategory"] })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>



<!-- JavaScript to handle the autocompletion for the book name field-->
@section Scripts{
<script>
        $(document).ready(function () {
            setupAutocomplete("#SearchString", "#bookSuggestions", "@Url.Action("SearchBooks", "Books")");
            preventStretchedLinkClick();
        });

        function toggleBookVisibility(bookId, currentStatus) {
            const newStatus = !currentStatus;

            $.ajax({
                url: '@Url.Action("BookVisibility", "Books")',
                type: 'POST',
                data: {
                    bookId: bookId,
                    isActive: newStatus
                },
                success: function () {
                    const icon = $('#toggle-icon-' + bookId);

                    if (newStatus) {
                        icon
                            .removeClass('bi-eye-slash text-danger')
                            .addClass('bi-eye text-success');
                    } else {
                        icon
                            .removeClass('bi-eye text-success')
                            .addClass('bi-eye-slash text-danger');
                    }

                    // Also update the onclick with the new state
                    $('#toggle-btn-' + bookId).attr('onclick', `toggleBookVisibility(${bookId}, ${newStatus})`);

                    showSuccessMessage("Book visibility updated successfully!");
                },
                error: function () {
                    showErrorMessage("Failed to update book visibility.");
                }
            });
        }
</script>
}