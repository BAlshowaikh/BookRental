    @if (ViewBag.TotalPages > 1)
    {
        <div class="row mt-4">
            <div class="col text-center">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, SearchString = Context.Request.Query["SearchString"], SearchCon = Context.Request.Query["SearchCon"] })">Previous</a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, SearchString = Context.Request.Query["SearchString"], SearchCon = Context.Request.Query["SearchCon"] })">@i</a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, SearchString = Context.Request.Query["SearchString"], SearchCon = Context.Request.Query["SearchCon"] })">Next</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            preventStretchedLinkClick();
        });
    </script>
}