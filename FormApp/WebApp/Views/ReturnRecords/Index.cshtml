                            <p>Book: @record.Book.Name</p>
                            <p>Condition: @record.BookCondition.ReturnCondition</p>
                            <p>Charges: @record.TotalAdditionalCharges</p>

                            <!-- Feedback Button Section -->
                            <div class="mt-auto d-flex justify-content-center gap-2 pt-2">
