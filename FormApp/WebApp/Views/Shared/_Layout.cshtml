<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Journal.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <meta charset="utf-8" />
</head>
<body>
    <header>
        @using Microsoft.AspNetCore.Identity
        @inject SignInManager<IdentityUser> SignInManager
        @inject UserManager<IdentityUser> UserManager

        @{
            string userRole = "";

            if (SignInManager.IsSignedIn(User))
            {
                var currentUser = await UserManager.GetUserAsync(User);
                if (currentUser != null) {
                    var roles = await UserManager.GetRolesAsync(currentUser);
                    userRole = roles.FirstOrDefault() ?? "";
                }
            }

            if (userRole == "Admin")
            {
                @await Html.PartialAsync("~/Views/Shared/NavigationBars/_AdminNavBar.cshtml")
            }
            else if (userRole == "Manager")
            {
                @await Html.PartialAsync("~/Views/Shared/NavigationBars/_ManagerNavBar.cshtml")
            }
            else if (userRole == "User")
            {
                @await Html.PartialAsync("~/Views/Shared/NavigationBars/_CustomerNavBar.cshtml")
            }
            else
            {
                <nav class="navbar navbar-expand navbar-dark bg-primary border-bottom shadow-sm fixed-top">
                    <div class="container-fluid">
                        <!-- Store Icon Logo -->
                        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-book-half fs-2"></i> <!-- Book Icon -->
                        </a>

                        <!-- Navigation Links (Centered) -->
                        <div class="d-flex justify-content-center flex-grow-1">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Books" asp-action="Index">Book List</a>
                                </li>
                            </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </nav>

            }
        }
    </header>

    </header>
    <div class="container mb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>



    <footer class="footer bg-white border-top mt-lg-4">
        <div class="container d-flex justify-content-center align-items-center text-dark" style="height: 30px;">
            &copy; 2025 - Book Nook Store
        </div>
    </footer>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/Helpers.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!--<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>-->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>



    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
