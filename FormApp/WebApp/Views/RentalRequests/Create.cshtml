@model BookRentalObject.RentalRequest

@{
	ViewData["Title"] = "Create";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">

<div class="container mt-2">
    <h1 class="display-5 fw-bold text-dark mb-3">Rent a Book</h1>
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">← Back to book list</a>
    <hr class="mb-4" />

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group mb-3">
            <label class="control-label">Book ID</label>
            <input class="form-control" value="@ViewBag.BookId" readonly />
            <input type="hidden" asp-for="BookId" value="@ViewBag.BookId" />
        </div>

        <div class="form-group mb-3">
            <label class="control-label">Book Name</label>
            <input class="form-control" value="@ViewBag.BookName" readonly />
        </div>

        <div class="form-group mb-3">
            <label class="control-label">User Name</label>
            <input class="form-control" value="Test user" readonly />
            <!--<input type="hidden" asp-for="UserId" value="@ViewBag.UserId" />-->
        </div>

        <div class="form-group mb-3">
            <label class="control-label">Rental Request Status</label>
            <input class="form-control" value="@ViewBag.RentalRequestStatus" readonly />
            <input type="hidden" asp-for="RentalRequestStatusId" value="@* Pending Status ID *@" />
        </div>

        <div class="form-group mb-3">
            <label asp-for="RentalStartDate" class="control-label"></label>
            <input asp-for="RentalStartDate" type="date" class="form-control" id="rentalStartDate" />
            <span asp-validation-for="RentalStartDate" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ReturnDate" class="control-label"></label>
            <input asp-for="ReturnDate" type="date" class="form-control" id="returnDate" />
            <span asp-validation-for="ReturnDate" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="TotalCost" class="control-label"></label>
            <input asp-for="TotalCost" class="form-control" id="totalCost" readonly />
        </div>

        <button type="submit" class="btn btn-success">Submit Rental Request</button>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        const rentalPrice = @ViewBag.RentalPrice;

            function calculateCost() {
                const start = new Date(document.getElementById('rentalStartDate').value);
                const end = new Date(document.getElementById('returnDate').value);

                if (start && end && end > start) {
                    const days = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
                    const totalCost = (days * rentalPrice).toFixed(2);
                    document.getElementById('totalCost').value = totalCost;
                } else {
                    document.getElementById('totalCost').value = '';
                }
            }

            const rentedRanges = @Html.Raw(ViewBag.RentedRanges);

            function isDateInRange(dateStr, fromStr, toStr) {
                const date = new Date(dateStr);
                const from = new Date(fromStr);
                const to = new Date(toStr);
                return date >= from && date <= to;
            }

            const disableBookedDates = (input) => {
                flatpickr(input, {
                    dateFormat: "Y-m-d",
                    disable: rentedRanges.map(r => ({
                        from: r.RentalStartDate,
                        to: r.ReturnDate
                    })),
                    onDayCreate: function(dObj, dStr, fp, dayElem) {
                        const dateStr = dayElem.dateObj.toISOString().split('T')[0];
                        rentedRanges.forEach(r => {
                            if (isDateInRange(dateStr, r.RentalStartDate, r.ReturnDate)) {
                                dayElem.style.border = "2px solid red";
                                dayElem.style.borderRadius = "50%";
                                dayElem.style.boxSizing = "border-box";
                                dayElem.setAttribute("title", "Rented on this date");
                            }
                        });
                    }
                });
            };

            document.addEventListener('DOMContentLoaded', () => {
                disableBookedDates(document.getElementById('rentalStartDate'));
                disableBookedDates(document.getElementById('returnDate'));

                document.getElementById('rentalStartDate').addEventListener('change', calculateCost);
                document.getElementById('returnDate').addEventListener('change', calculateCost);

        });

    </script>
}
