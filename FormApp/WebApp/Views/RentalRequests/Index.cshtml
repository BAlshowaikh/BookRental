@model IEnumerable<BookRentalObject.RentalRequest>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-dark text-center">Rental Requests</h1>

<div class="container my-4">
	<div class="row">
		@foreach (var request in Model)
		{
			var borderClass = request.RentalRequestStatus.RentalRequestStatusId switch
			{
				1 => "border border-2 border-dark border-opacity-100", // gray
				2 => "border border-2 border-success border-opacity-100",   // green
				3 => "border border-2 border-danger border-opacity-100",    // red
				_ => "border border-2 border-dark border-opacity-100"       // fallback
			};

			<div class="col-md-4">
				<div class="main-card mb-4 card-clickable @borderClass"
					 data-bs-toggle="modal"
					 data-bs-target="#detailsModal-@request.RequestId"
					 style="cursor: pointer;">

					<div class="card-info">
						<h3 class="text-dark">Request ID: @request.RequestId</h3>
						<h5>Book Name: @request.Book.Name</h5>
						<h5>Request Status: @request.RentalRequestStatus.Status</h5>

						<div class="mt-3 d-flex flex-wrap gap-2">
							<a asp-action="Edit"
							   asp-route-id="@request.RequestId"
							   class="btn btn-sm btn-light">
								Edit
							</a>

							@if (request.RentalRequestStatus.Status == "Pending")
							{
								<form asp-action="Approve" asp-route-id="@request.RequestId" method="post">
									<button type="submit" class="btn btn-sm btn-success text-light">Approve</button>
								</form>
								<form asp-action="Reject" asp-route-id="@request.RequestId" method="post">
									<button type="submit" class="btn btn-sm btn-danger">Reject</button>
								</form>
							}
						</div>
					</div>
				</div>

				<!-- Modal for each request details -->
				<div class="modal fade fade-scale" id="detailsModal-@request.RequestId" tabindex="-1" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content shadow-lg rounded-3">
							<div class="modal-header bg-secondary text-white border-0">
								<h5 class="modal-title w-100 text-center">
									<i class="bi bi-info-circle me-2"></i>
									Rental Request Details
								</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								<div class="info-group mb-3">
									<p><strong>Request ID:</strong> @request.RequestId</p>
									<p><strong>Status:</strong> @request.RentalRequestStatus.Status</p>
									<p><strong>Book Name:</strong> @request.Book.Name</p>
									<p><strong>Username:</strong> @request.User.FullName</p>
									<p><strong>Rental Start Date:</strong> @request.RentalStartDate</p>
									<p><strong>Return Date:</strong> @request.ReturnDate</p>
									<p><strong>Total Cost:</strong> @request.TotalCost</p>
								</div>
								<div class="text-center">
									<button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			preventStretchedLinkClick();

			var approveSuccess = '@TempData["ApproveSuccess"]';
			var redirectData = '@TempData["RedirectToTransaction"]';
			var rejectSuccess = '@TempData["RejectSuccess"]';
			var successMessage = '@TempData["SuccessMessage"]';
			var errorMessage = '@TempData["ErrorMessage"]';

			if (approveSuccess) {
				showSuccessMessage(approveSuccess);

				// Delay before redirect
				if (redirectData) {
					setTimeout(function () {
						var data = JSON.parse(redirectData.replace(/&quot;/g, '"'));
						var url = `/RentalTransactions/Create?rentalRequestId=${data.rentalRequestId}&bookId=${data.bookId}&userId=${data.userId}&rentalStartDate=${data.rentalStartDate}&returnDate=${data.returnDate}&totalCost=${data.totalCost}`;
						window.location.href = url;
					}, 1500); // Wait 1.5 seconds
				}
			}

			if (rejectSuccess) {
				showSuccessMessage(rejectSuccess);
			}
		});
	</script>
}
