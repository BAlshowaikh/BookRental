@model IEnumerable<BookRentalObject.RentalRequest>

@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-dark text-center">Rental Requests</h1>

<div class="container my-4">
	<div class="row">

		<!-- Search and filter -->
		<div class="row py-3">
			<div class="col-12">
				<form asp-controller="RentalRequests" asp-action="Index" method="get" class="row gx-2 align-items-center">

					<!-- Search by Request ID -->
					<div class="col-auto">
						<label class="form-label">Request ID:</label>
					</div>
					<div class="col-auto">
						<input type="number" name="SearchRequestId" value="@Context.Request.Query["SearchRequestId"]" class="form-control" placeholder="e.g. 1" min="1" />
					</div>

					<!-- Filter by Status -->
					<div class="col-auto">
						<label class="form-label">Status:</label>
					</div>
					<div class="col-auto">
						<select name="SearchStatusId" asp-items="ViewBag.StatusList" class="form-select">
							<option value="">All</option>
						</select>
					</div>

					<!-- Push buttons to right -->
					<div class="col"></div>

					<!-- Search & Clear -->
					<div class="col-auto">
						<input type="submit" value="Search" class="btn btn-primary mx-3" />
					</div>
					<div class="col-auto">
						<a asp-action="Index" class="btn btn-outline-danger">Clear</a>
					</div>
				</form>
			</div>
		</div>


		@foreach (var request in Model)
		{
			var borderClass = request.RentalRequestStatus.RentalRequestStatusId switch
			{
				1 => "border border-2 border-primary border-opacity-100", // gray
				2 => "border border-2 border-success border-opacity-100",   // green
				3 => "border border-2 border-danger border-opacity-100",    // red
				_ => "border border-2 border-primary border-opacity-100"       // fallback
			};

			<div class="col-md-4">
				<div class="main-card mb-4 card-clickable @borderClass"
					 data-modal-id="detailsModal-@request.RequestId"
					 style="cursor: pointer;">


					<div class="card-info">
						<h3>Request ID: @request.RequestId</h3>
						<p>Book Name: @request.Book.Name</p>
						<p>Request Status: @request.RentalRequestStatus.Status</p>

						<div class="mt-3 d-flex flex-wrap gap-2">
							<a asp-action="Edit"
							   asp-route-id="@request.RequestId"
							   class="btn btn-sm btn-light">
								Edit
							</a>

							@if (request.RentalRequestStatus.Status == "Pending")
							{
								<form asp-action="Approve" asp-route-id="@request.RequestId" method="post" class="prevent-stretch">
									<button type="submit" class="btn btn-sm btn-success text-light">Approve</button>
								</form>
								<form asp-action="Reject" asp-route-id="@request.RequestId" method="post" class="prevent-stretch">
									<button type="submit" class="btn btn-sm btn-danger">Reject</button>
								</form>
							}
						</div>
					</div>
				</div>

				<!-- Modal for each request details -->
				<div class="modal fade fade-scale" id="detailsModal-@request.RequestId" tabindex="-1" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content shadow-lg rounded-3">
							<div class="modal-header bg-secondary text-white border-0">
								<h5 class="modal-title w-100 text-center">
									<i class="bi bi-info-circle me-2"></i>
									Rental Request Details
								</h5>
								<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								<div class="info-group mb-3">
									<p><strong>Request ID:</strong> @request.RequestId</p>
									<p><strong>Status:</strong> @request.RentalRequestStatus.Status</p>
									<p><strong>Book Name:</strong> @request.Book.Name</p>
									<p><strong>Username:</strong> @request.User.FullName</p>
									<p><strong>Rental Start Date:</strong> @request.RentalStartDate</p>
									<p><strong>Return Date:</strong> @request.ReturnDate</p>
									<p><strong>Total Cost:</strong> @request.TotalCost</p>
									@if (request.Documents != null && request.Documents.Any())
									{
										<div class="mt-2">
											<a asp-action="DownloadDocument"
											   asp-route-id="@request.RequestId"
											   class="btn btn-sm btn-outline-dark">
												<i class="bi bi-download me-1"></i> Download Document
											</a>
										</div>
									}

								</div>
								<div class="text-center">
									<button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Close</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- Pagination -->
		<div class="row mt-4">
			<div class="col text-center">
				@if (ViewBag.TotalPages > 1)
				{
					<nav aria-label="Page navigation">
						<ul class="pagination justify-content-center">
							@for (int i = 1; i <= ViewBag.TotalPages; i++)
							{
								<li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
									<a class="page-link"
									   href="@Url.Action("Index", new {
                                   page = i,
                                   SearchRequestId = Context.Request.Query["SearchRequestId"],
                                   SearchStatusId = Context.Request.Query["SearchStatusId"]
                               })">@i</a>
								</li>
							}
						</ul>
					</nav>
				}
			</div>
		</div>

	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			preventStretchedLinkClick();

			var approveSuccess = '@TempData["ApproveSuccess"]';
			var redirectData = '@TempData["RedirectData"]';
			var rejectSuccess = '@TempData["RejectSuccess"]';
			//var successMessage = '@TempData["SuccessMessage"]';
			//var errorMessage = '@TempData["ErrorMessage"]';

					// Manually open modal on card click
		$('.card-clickable').on('click', function () {
			const modalId = $(this).data('modal-id');
			const modal = document.getElementById(modalId);

			if (modal) {
				const bsModal = new bootstrap.Modal(modal);
				bsModal.show();
			}
		});

			if (approveSuccess &&  redirectData) {
					showSuccessMessage(approveSuccess);

				
				// Delay before redirect
				if (redirectData) {
					setTimeout(function () {
						var data = JSON.parse(redirectData.replace(/&quot;/g, '"'));
						var url = `/RentalTransactions/Index?fromRequest=true&bookId=${data.bookId}&userId=${data.userId}&rentalStartDate=${data.rentalStartDate}&returnDate=${data.returnDate}&totalCost=${data.totalCost}`;
						window.location.href = url;
					}, 2000); 
				}
			}

			if (rejectSuccess) {
				showSuccessMessage(rejectSuccess);
			}
		});
	</script>
}
