@model IEnumerable<BookRentalObject.AuditTrail>

@{
    ViewData["Title"] = "Audit Trails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center text-dark mb-4">Audit Trails</h2>

    <div class="row align-items-end mb-3 gx-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <!-- Filter Form -->
            <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-3" autocomplete="off">
                <div class="d-flex align-items-center gap-2 me-3">
                    <label for="auditId" class="form-label mb-0">Audit ID:</label>
                    <input type="number" name="auditId" id="auditId" class="form-control"
                           value="@Context.Request.Query["auditId"]" />
                </div>

                <div class="d-flex align-items-center">
                    <label for="userId" class="form-label mb-0 me-2">User:</label>
                    @Html.DropDownList("userId", (SelectList)ViewBag.Users, "Select User", new { @class = "form-select" })
                </div>

                <input type="submit" value="Search" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Audit ID</th>
                    <th>Timestamp</th>
                    <th>Old Value</th>
                    <th>New Value</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center">No records found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AuditId</td>
                            <td>@item.Timestamp.ToString("g")</td>
                            <td>@item.OldValue</td>
                            <td>@item.NewValue</td>
                            <td>@(item.User?.FullName ?? "N/A")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <style>
        .table-hover tbody tr {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            background-color: transparent !important;
        }

            .table-hover tbody tr:hover {
                transform: scale(1.01);
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
                background-color: rgba(255, 255, 255, 0.5) !important;
                border-radius: 0.5rem;
                position: relative;
                z-index: 1;
            }

        .badge {
            font-size: 0.9rem;
            border-radius: 1rem;
        }


        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 1rem;
            color: #fff;
            font-weight: bold;
            font-size: 0.9rem;
            text-align: center;
            min-width: 80px;
        }

        .bg-active {
            background-color: #2e7d32; /* dark green */
        }

        .bg-inactive {
            background-color: #c62828; /* dark red */
        }

        .btn-brown {
            background-color: #8a5a44;
            color: white;
            border: none;
        }

            .btn-brown:hover {
                background-color: #754b39;
                color: white;
            }

        .form-label {
            white-space: nowrap;
        }

        .table,
        .table thead,
        .table tbody,
        .table th,
        .table td {
            background-color: transparent !important;
        }

        /* Table Header Styling */
        table thead tr {
            background-color: #a97463;
        }

        table thead th {
            color: white !important;
            font-weight: bold;
            font-size: 1rem;
            vertical-align: middle;
        }


        .table-light {
            background-color: transparent !important;
        }

        .table-responsive {
            background-color: transparent !important;
        }

    </style>
}
