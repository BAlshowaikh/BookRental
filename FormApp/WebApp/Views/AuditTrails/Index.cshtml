@model IEnumerable<BookRentalObject.AuditTrailViewModel>

@{
    ViewBag.Title = "Audit Trails";
}

<h2>Audit Trails</h2>

@using (Html.BeginForm("Index", "AuditTrail", FormMethod.Get))
{
    <div class="form-inline mb-3">
        <label for="auditId">Audit ID:</label>
        <input type="number" name="auditId" id="auditId" class="form-control mx-2" />

        <label for="userId">User:</label>
        @Html.DropDownList("userId", (SelectList)ViewBag.Users, "Select User", new { @class = "form-control mx-2" })

        <button type="submit" class="btn btn-primary mx-1">Filter</button>
        <a href="@Url.Action("Index", "AuditTrail")" class="btn btn-secondary">Reset</a>
    </div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Audit ID</th>
            <th>Timestamp</th>
            <th>Old Value</th>
            <th>New Value</th>
            <th>User</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No records found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.AuditId</td>
                    <td>@item.Timestamp</td>
                    <td>@item.OldValue</td>
                    <td>@item.NewValue</td>
                    <td>@item.UserFullName</td>
                </tr>
            }
        }
    </tbody>
</table>
